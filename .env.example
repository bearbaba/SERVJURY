# SERVJURY demo is fixture-only by default. Never commit a filled .env.
HOST=127.0.0.1
PORT=4173
ENABLE_LIVE_TRANSACTIONS=0

# Stable GenLayer Studio (https://studio.genlayer.com): Studionet chain ID 61999.
# Studio-dev uses a DIFFERENT chain (61997); do not use this preset for studio-dev.
GENLAYER_NETWORK=studionet
GENLAYER_CONTRACT_ADDRESS=0x7040Db57D130C9c121Ad7152143b5076abB3c2B5

# For an authenticated OpenServ integration test, set live mode to 1 and use
# only a dedicated, expendable testnet key. Never expose keys in chat/GitHub.
GENLAYER_PRIVATE_KEY=

# Required for provisioning OpenServ PLATFORM identity: user-level API key
# (not OPENSERV_API_KEY, which is an agent credential after provisioning).
# Prefer GitHub Codespaces secret OPENSERV_USER_API_KEY, NOT a plaintext .env.
# The wallet/SIWE nonce endpoint returned HTTP 404 on 2026-11-10.
OPENSERV_USER_API_KEY=

# Agent credentials are obtained through provision(); do not invent or
# manually reuse a different agent's OPENSERV_API_KEY.

# One-time explicit authorization to file a new case when on-chain get_case
# returns exactly 'Unknown case'. Turn off after the first verified run.
ALLOW_FIRST_FILING=0
