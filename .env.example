# The standalone demo needs ZERO secrets and ZERO dependencies.
HOST=127.0.0.1
PORT=4173
# To enable on-chain writes: install dependencies and set all variables below.
ENABLE_LIVE_TRANSACTIONS=0
GENLAYER_NETWORK=studionet
GENLAYER_CONTRACT_ADDRESS=
GENLAYER_PRIVATE_KEY=
# OpenServ's SDK will provision its own credentials when you run npm run agent.
# OPENSERV_USER_API_KEY=  # only needed for OpenServ Cloud deploy
