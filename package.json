{
  "name": "servjury",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Internet Court x OpenServ x GenLayer adjudication demo lab",
  "scripts": {
    "demo": "node demo/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && python -m py_compile contracts/ServJury.py && python -m unittest discover -s tests -p 'test_*.py' -v",
    "agent": "node --env-file-if-exists=.env agent/openserv-agent.mjs",
    "task:openserv": "node --env-file-if-exists=.env scripts/run-openserv-task.mjs",
    "task:inspect": "node --env-file-if-exists=.env scripts/inspect-openserv-tasks.mjs",
    "task:detail": "node --env-file-if-exists=.env scripts/inspect-openserv-task-detail.mjs",
    "task:chain": "node --env-file-if-exists=.env scripts/audit-onchain-tasks.mjs",
    "tx:inspect": "node --env-file-if-exists=.env scripts/inspect-genlayer-file-tx.mjs"
  },
  "dependencies": {
    "@openserv-labs/client": "2.5.3",
    "@openserv-labs/sdk": "2.4.1",
    "genlayer-js": "1.1.8",
    "zod": "4.6.7",
    "tsx": "4.23.15"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
